{
  "name": "@gsft/gruntfoot",
  "version": "0.5.0",
  "type": "module",
  "description": "A flexible footer customization extension for Pi coding agent, including a full-replacement footer with real-time color customization, themes, and an easy toggle option that persists across sessions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruntsoft/gruntfoot.git"
  },
  "homepage": "https://github.com/gruntsoft/gruntfoot#readme",
  "bugs": "https://github.com/gruntsoft/gruntfoot/issues",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "docs"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/gruntsoft/gruntfoot/main/docs/gruntfoot.png",
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true
  }
}
